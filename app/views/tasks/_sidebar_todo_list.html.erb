<%# 3. 未完了タスクセクション抜き出し %>

<ul id="sidebar_todo_list" style="list-style: none; padding: 0;">
 <% if todo_list.any? %>
      <% todo_list.each do |todo| %>
        <li class="sidebar-task-item" style="margin-bottom: 10px; border-bottom: 1px solid #eee; padding-bottom: 5px;">
          <strong>
            <%= link_to todo.title, task_path(todo),style: "text-decoration: none; color: #333;",data: {turbo_frame: "modal_task_detail", action: "click->modal#open",turbo: true} %>
          </strong>
          <div style="font-size: 0.7rem; color: #888;">〆 <%= todo.deadline.strftime("%m/%d %H:%M") %></div>
        </li>
      <% end %>
      <% else %>
    <%# リストが空になった時のメッセージ %>
    <li style="font-size: 0.8rem; color: #999; padding: 10px 0;">未完了のタスクはありません</li>
  <% end %>
    </ul>