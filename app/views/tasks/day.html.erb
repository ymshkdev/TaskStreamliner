<div class="google-calendar-layout" data-controller="modal">
 <div class="sidebar">
   <div class="mini-calendar-section">
    <%# 1. 年月と切り替えボタンの独自ヘッダー %>
     <div class="custom-calendar-header">
      <%= link_to "前月", day_tasks_path(date: @date, start_date: @start_date.prev_month), class: "nav-btn" %>
      <span class="calendar-title-js">
      <span class="year"><%= @start_date.year %></span>年 
      <span class="month"><%= @start_date.month %></span>月
      </span>
      <%= link_to "次月", day_tasks_path(date: @date, start_date: @start_date.next_month), class: "nav-btn" %>
     </div>

    <%# 2. カレンダー本体：header: false で Gem標準のヘッダーを生成させない %>
    <div class="mini-calendar-body">
     <%= month_calendar(events: @month_tasks, start_date: @start_date, header: false) do |date, tasks| %>
      <% 
      # 休日・土日判定ロジック
       holiday = HolidayJp.between(date, date).first
       date_class = if holiday || date.sunday?
                     'text-danger' # 祝日・日曜は赤
                    elsif date.saturday?
                     'text-info'   # 土曜は青（Bootstrapのinfoカラー）
                    else
                     ''
                    end
      %>
      <div class="mini-day-cell <%= 'active-day' if date == @date %>">
        <%= link_to date.day, day_tasks_path(date: date, start_date: @start_date), 
                  class: date_class, 
                  style: "font-size: 0.8rem; text-decoration: none;" %>
      </div>
     <% end %>
    </div>
   </div>
   <div class="todo-sidebar-section">
     <h3 class="sidebar-title">未完了タスク</h3>
     <div class="todo-list-scroll">
      <% @todo_list.each do |todo| %>
       <div class="todo-item">
         <span class="priority"><%= "🚩" if todo.priority_high? %></span>
         <span class="title"><%= todo.title %></span>
         <span class="date"><%= todo.deadline&.strftime("%m/%d") %></span>
        </div>
      <% end %>
      </div>
     </div>
   </div>

   
    <div class="main-content">
     <div class="timeline-header d-flex justify-content-between align-items-center">
      <div class="d-flex align-items-center">
       <%= link_to "← カレンダーに戻る", tasks_path(start_date: @start_date), class: "btn btn-outline-secondary btn-sm me-3" %>
       <% # 土日祝の判定
        is_holiday = HolidayJp.between(@date, @date).first
        date_color_class = if is_holiday || @date.sunday?
                            'text-danger'
                           elsif @date.saturday?
                            'text-info'
                           else
                           ''
                           end
       %>
       <div class="date-display d-flex align-items-baseline">
        <%# 1. 数字部分に色を適用 %>
         <span class="day-num <%= date_color_class %>" style="font-size: 1.5rem; font-weight: bold;">
          <%= @date.day %>
          </span>
        <%# 2. 曜日部分：土日祝なら色を付け、平日なら元の text-muted を使う %>
         <span class="day-name ms-2 <%= date_color_class.presence || 'text-muted' %>">
          <%= I18n.t('date.abbr_day_names')[@date.wday] %>(<%= @date.strftime("%a") %>)
          <% if is_holiday %>
          <small class="ms-1" style="font-size: 0.8rem;">- <%= is_holiday.name %></small>
          <% end %>
         </span>
       </div>
       <%= link_to "今日", day_tasks_path(date: Date.today), class: "btn btn-sm btn-light border ms-3" %>
      </div>
      <%= link_to '+ 作成', new_task_path(selected_date: @date, return_to: 'day', start_date: @start_date), class: "btn btn-primary shadow-sm" %>
     </div>

    <div class="day-timeline">
     <% (0..23).each do |hour| %>
     <div class="hour-row">
      <div class="hour-label"><%= sprintf("%02d:00", hour) %></div>
      <div class="hour-slot"></div>
     </div>
     <% end %>

     <div class="events-container">
      <% @day_tasks.each do |task| %>
      <% status_class = task.done? ? 'completed-task' : '' %>
      <% if task.schedule? %>
      <% 
        # その日の「開始」と「終了」の基準
        day_start = @date.beginning_of_day
        day_end = @date.end_of_day
        # ---  日またぎ判定フラグ ---
        is_from_yesterday = task.start_at < day_start
        is_to_tomorrow = task.end_at > day_end
        # 描画用の時間を計算（前日からの続きなら00:00から、翌日へ続くなら24:00まで）
        display_start = [task.start_at, day_start].max
        display_end = [task.end_at, day_end].min
        # 表示位置（top）と高さ（height）を算出
        top = (display_start.hour * 60) + (display_start.min)
        height = ((display_end - display_start) / 60).to_i
        # 表示用のテキスト
        # 前日から跨いでいる場合は「前日〜」、翌日へ跨ぐ場合は「〜翌日」等の表記にする
        start_str = is_from_yesterday ? "前日" : task.start_at.strftime("%H:%M")
        end_str = is_to_tomorrow ? "翌日" : task.end_at.strftime("%H:%M")
        # --- 5. つなぎ目のスタイル調整（追加：点線にする工夫） ---
        # 前日からなら上を平らに、翌日までなら下を平らにするCSS
        multi_day_style = ""
        multi_day_style += "border-top: 2px dashed #999; border-top-left-radius: 0; border-top-right-radius: 0;" if is_from_yesterday
        multi_day_style += "border-bottom: 2px dashed #999; border-bottom-left-radius: 0; border-bottom-right-radius: 0;" if is_to_tomorrow
      %>      
      <%# heightが0以下の場合は描画しない（例えば24:00ちょうど終了のタスクなど） %>
      <% if height > 0 %>
       <div class="event-block <%= status_class %>" style="top: <%= top %>px; height: <%= height %>px; <%= multi_day_style %>">
        <%= link_to task_path(task),class: "event-link", data: {turbo_frame: "modal_task_detail",action: "click->modal#open"} do %>
         <div class="event-inner">
         <strong>
           <%# 前日からなら矢印をつける %>
           <%= "↑ " if is_from_yesterday %><%= task.title %><%= " ↓" if is_to_tomorrow %>
         </strong>
          <p><%= start_str %> - <%= end_str %></p>
         </div>
          <% end %>
        </div>
      <% end %>

    <% elsif task.todo? && task.deadline.present? %>
      <%# TODOの〆切表示（これはその日の範囲にある場合のみ表示） %>
      <% if task.deadline.to_date == @date %>
        <div class="deadline-line <%= status_class %>" style="top: <%= (task.deadline.hour * 60) + (task.deadline.min) %>px;">
          <%= link_to task_path(task),class: "event-link",data: {turbo_frame: "modal_task_detail",action: "click->modal#open"} do %>
            <span class="deadline-text">〆 <%= task.title %> (<%= task.deadline.strftime("%H:%M") %>)</span>
          <% end %>
        </div>
      <% end %>
    <% end %>
  <% end %>
 </div>
 <%# 2. モーダルの「受け皿」をこのページにも設置 %>
  <div data-modal-target="overlay" class="modal-overlay" data-action="click->modal#closeOutside">
    <div data-modal-target="content" class="modal-content">
      <%= turbo_frame_tag "modal_task_detail", data: { action: "turbo:frame-load->modal#reposition" } %>
    </div>
  </div>

</div>
    </div>


<script>
  window.setupDayPageJump = function() {
    console.log("JS check: function called");
    
    // クラス名を HTML と一致させる
    const titleElement = document.querySelector('.calendar-title-js');
    if (!titleElement) {
      console.log("JS check: .calendar-title-js NOT FOUND");
      return;
    }

    if (titleElement.querySelector('select')) return;

    // 現在の表示から数値を取得
    // titleElement.textContent ではなく、中の span から取るとより確実です
    const yearSpan = titleElement.querySelector('.year');
    const monthSpan = titleElement.querySelector('.month');
    
    const currentYear = yearSpan ? yearSpan.textContent.trim() : new Date().getFullYear();
    const currentMonth = monthSpan ? monthSpan.textContent.trim() : new Date().getMonth() + 1;

    console.log(`Target Found: ${currentYear}年 ${currentMonth}月`);

    const createSelect = (start, end, selected, name) => {
      let html = `<select class="select-jump ${name}" style="border:none; background:transparent; font-weight:bold; font-size:1rem; cursor:pointer; color:inherit;">`;
      for (let i = start; i <= end; i++) {
        // 数値比較のために parseInt
        const isSelected = parseInt(i) === parseInt(selected);
        html += `<option value="${i}" ${isSelected ? 'selected' : ''}>${i}</option>`;
      }
      return html + `</select>`;
    };

    // 中身をプルダウンに書き換え
    titleElement.innerHTML = `
      ${createSelect(2020, 2030, currentYear, 'year')}年
      ${createSelect(1, 12, currentMonth, 'month')}月
    `;

    // 変更時のリダイレクト処理
    const urlParams = new URLSearchParams(window.location.search);
    titleElement.querySelectorAll('select').forEach(select => {
      select.addEventListener('change', () => {
        const year = titleElement.querySelector('.year').value;
        const month = String(titleElement.querySelector('.month').value).padStart(2, '0');
        const currentDate = urlParams.get('date') || '<%= @date %>';
        const newStartDate = `${year}-${month}-01`;
        
        console.log("Redirecting to:", newStartDate);
        window.location.href = `${window.location.pathname}?date=${currentDate}&start_date=${newStartDate}`;
      });
    });
  };

  document.addEventListener('turbo:load', window.setupDayPageJump);
  document.addEventListener('turbo:render', window.setupDayPageJump);
  window.setupDayPageJump();
</script>