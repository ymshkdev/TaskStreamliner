<div id="<%= dom_id(task) %>" class="task-entry <%= task.task_type %> <%= "status-#{task.status}" if task.todo? || task.schedule? %>" data-team-id="<%= task.teams.first&.id %>">
  <%# 予定 (schedule) の場合：時間を表示 %>
  <% if task.schedule? && task.start_at.present? %>
    <span style="font-size: 0.8em; color: #666;">
     <% if task.start_at.to_date == task.end_at.to_date %>
      <%# 1. 同日の場合：通常通り 10:00 - 12:00 %>
      <%= task.start_at.strftime("%H:%M") %> - <%= task.end_at.strftime("%H:%M") %>
    <% else %>
      <%# 2. 日をまたぐ場合 %>
      <% if date == task.start_at.to_date %>
        <span style="color: #007bff; font-weight: bold;">(始)</span> <%= task.start_at.strftime("%H:%M") %>〜
      <% elsif date == task.end_at.to_date %>
        〜<%= task.end_at.strftime("%H:%M") %> <span style="color: #dc3545; font-weight: bold;">(終)</span>
      <% else %>
        <span style="color: #6c757d; font-weight: bold;">(継続中)</span>
      <% end %>
    <% end %>
  </span>
<% end %>

  <%# タスク (todo) の場合：〆時間を表示 %>
  <% if task.todo? && task.deadline.present? %>
    <div class="task-deadline-time" style="font-size: 0.75em; color: #d9534f; font-weight: bold; line-height: 1.2;">
      〆 <%= task.deadline.strftime("%H:%M") %>
    </div>
  <% end %>

  <%# タイトル部分 %>
  <%= link_to task_path(task, start_date: start_date), data: { turbo_frame: "modal_task_detail", action: "click->modal#open" }, class: "task-link" do %>
    <% if task.todo? && task.priority_high? %>
      <span title="優先度：高">🚩</span>
    <% end %>
    <%= task.title %>
  <% end %>
</div>